<http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem> rdf:type owl:Ontology ;
                                                                   rdfs:comment "This is ontology about planet system"@en .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#звезды
:звезды rdf:type owl:Class ;
        rdfs:subClassOf :космическое_тело .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#спутники
:спутники rdf:type owl:Class ;
          rdfs:subClassOf :космическое_тело .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem/космическое_тело
:космическое_тело rdf:type owl:Class ;
                  rdfs:subClassOf :солнечная_система ;
                  owl:disjointWith :планеты ,
                                   :солнечная_система .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem/планеты
:планеты rdf:type owl:Class ;
         rdfs:subClassOf :космическое_тело .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem/солнечная_система
:солнечная_система rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#деймос
:деймос rdf:type owl:NamedIndividual ,
                 :спутники .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#земля
:земля rdf:type owl:NamedIndividual ,
                :планеты .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#луна
:луна rdf:type owl:NamedIndividual ,
               :спутники .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#марс
:марс rdf:type owl:NamedIndividual ,
               :планеты .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#меркурий
:меркурий rdf:type owl:NamedIndividual ,
                   :планеты .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#солнце
:солнце rdf:type owl:NamedIndividual ,
                 :звезды .


###  http://www.semanticweb.org/admin/ontologies/2026/8/planetsystem#фобос
:фобос rdf:type owl:NamedIndividual ,
                :спутники .


